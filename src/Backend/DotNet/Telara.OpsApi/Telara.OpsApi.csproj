<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b6d0f8a1-6e6b-4e6a-9d3e-0c8f5b8a2b4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.5.1" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.5.1" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.5.1" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.5.1" />
    <PackageReference Include="HotChocolate.Types.Analyzers" Version="16.5.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telara.Core\Telara.Core.csproj" />
    <ProjectReference Include="..\Telara.Domain\Telara.Domain.csproj" />
  </ItemGroup>

</Project>
